#!/usr/bin/env bash
set -euo pipefail
# Brewfile checksum: {{ include "Brewfile" | sha256sum }}

if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi

brew_binary=""
for candidate in "$HOME/.homebrew/bin/brew" "/opt/homebrew/bin/brew" "/usr/local/bin/brew"; do
  if [ -x "$candidate" ]; then
    brew_binary="$candidate"
    break
  fi
done

if [ -z "$brew_binary" ] && command -v brew >/dev/null 2>&1; then
  brew_binary="$(command -v brew)"
fi

if [ -z "$brew_binary" ]; then
  echo "Homebrew is required before running brew bundle" >&2
  exit 1
fi

brewfile="{{ .chezmoi.sourceDir }}/Brewfile"

if [ ! -f "$brewfile" ]; then
  echo "Brewfile not found: $brewfile" >&2
  exit 1
fi

if "$brew_binary" bundle check --no-upgrade --file "$brewfile"; then
  exit 0
fi

"$brew_binary" bundle install --file "$brewfile" --no-upgrade
